{
    "name": "istiak-tridip/laravel-sqids",
    "homepage": "https://github.com/istiak-tridip/laravel-sqids",
    "description": "Laravel wrapper for Sqids to obscure database IDs with unique, URL-safe identifiers.",
    "keywords": [
        "php",
        "laravel",
        "sqids",
        "laravel-sqids"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "sqids/sqids": "^0.5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^9.0|^10.9.0|^11.0",
        "pestphp/pest": "^3.8.5|^4.4.1",
        "pestphp/pest-plugin-type-coverage": "^3.6.1|^4.0.3"
    },
    "autoload": {
        "psr-4": {
            "Istiak\\Sqids\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix:style": "pint",
        "test:style": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always --parallel",
        "test": [
            "@test:style",
            "@test:types",
            "@test:unit",
            "@test:unit -- --type-coverage --min=100"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Istiak\\Sqids\\SqidsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
