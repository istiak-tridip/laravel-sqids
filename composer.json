{
    "name": "istiak-tridip/laravel-sqids",
    "homepage": "https://github.com/istiak-tridip/laravel-sqids",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0||^12.0",
        "illuminate/support": "^11.0||^12.0"
    },
    "autoload": {
        "psr-4": {
            "Istiak\\Sqids\\": "src/"
        }
    },
    "scripts": {
        "fix:style": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Istiak\\Sqids\\SqidsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "laravel/pint": "^1.21"
    }
}
